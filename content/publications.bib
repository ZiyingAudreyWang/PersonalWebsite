@inproceedings{wang2024generative,
  selected={true},
  title = {Generative Art in Your Pocket: User Perception and Acceptance of AI-Generated Abstract Art for Mobile Wallpapers},
  author = {Ziying Wang and Yucheng Jin},
  year = {2024},
  month = {11},
  booktitle = {Proceedings of the Twelfth International Symposium of Chinese CHI},
  doi = {10.1145/3758871.3758940},
  url = {https://dl.acm.org/doi/abs/10.1145/3758871.3758940},
  abstract = {Generative AI is increasingly applied in various creative fields due to its creativity. This study explores how users perceive AI-generated abstract art as mobile phone wallpapers compared to those created by human designers. We conducted a lab study with 34 participants, who completed two tasks to compare AI-generated and human-made wallpapers regarding user acceptance and assess if they could distinguish between them. Additionally, we examined whether personality traits and aesthetic literacy impact user acceptance of AI-generated wallpapers. The results indicate that human-designed wallpapers are rated more favorably than AI-generated ones regarding user acceptance. Extraversion and openness positively relate to users' intention to use AI-generated wallpapers, while conscientiousness shows a negative correlation. Moreover, most participants cannot distinguish AI-generated art from human-made designs. This study provides insights into the potential use of generative art for mobile wallpapers.},
  description={Chinese CHI 2024.},
  keywords={Generative AI, Creative AI, Aesthetics, HCI}
}

@inproceedings{wang2026emotistage,
  selected={true},
  title = {EmotiStage: Designing an Emotion-Driven Performance System with Multi-modal Generative AI to Support Emotional Awareness},
  author = {Ziying Wang and Yihong Lin and Xianglin Zhao and Yirui Huang and Ziya Zhou and Wei Xue and Wanling Cai and Yucheng Jin},
  year = {2026},
  month = {10},
  booktitle = {Proceedings of the ACM International Conference on Multimodal Interaction (ICMI '26)},
  note = {Accepted; not yet published},
  abstract = {Emotional awareness is a foundational component of mental wellbeing, yet existing digital tools often reduce emotional experience to labels, metrics, or inferred states. Such approaches overlook how emotional awareness is constructed through embodied, multimodal experience and reflective sense-making. We present EmotiStage, an emotion-driven performance system powered by multimodal generative AI that supports emotional awareness by enabling users to externalize, observe, and reinterpret emotions through music and stage performance. By guiding users through a creator-to-spectator transition, EmotiStage introduces aesthetic and psychological distance, allowing users to re-encounter their internal states as a staged performance. A mixed-method study (N = 13) suggests that EmotiStage supports emotional awareness by facilitating a progression from expression to observation, helping users visualize and re-experience emotional experiences. We contribute EmotiStage, a multi-modal generative AI system for emotional awareness, alongside exploratory empirical findings and design implications for using multi-modal generative arts to support emotional awareness in mental well-being contexts.},
  description={Long paper, ICMI 2026 (Napoli, Italy). Co-first author with Yihong Lin.},
  keywords={Creative AI, Emotional Awareness, Multimodal Generative AI, Human-Computer Interaction}
}