@inproceedings{wang2024generative,
  selected={true},
  preview={generative-art-teaser.png},
  title = {Generative Art in Your Pocket: User Perception and Acceptance of AI-Generated Abstract Art for Mobile Wallpapers},
  author = {Ziying Wang and Yucheng Jin},
  year = {2024},
  month = {11},
  booktitle = {Proceedings of the Twelfth International Symposium of Chinese CHI},
  doi = {10.1145/3758871.3758940},
  url = {https://dl.acm.org/doi/abs/10.1145/3758871.3758940},
  abstract = {Generative AI is increasingly applied in various creative fields due to its creativity. This study explores how users perceive AI-generated abstract art as mobile phone wallpapers compared to those created by human designers. We conducted a lab study with 34 participants, who completed two tasks to compare AI-generated and human-made wallpapers regarding user acceptance and assess if they could distinguish between them. Additionally, we examined whether personality traits and aesthetic literacy impact user acceptance of AI-generated wallpapers. The results indicate that human-designed wallpapers are rated more favorably than AI-generated ones regarding user acceptance. Extraversion and openness positively relate to users' intention to use AI-generated wallpapers, while conscientiousness shows a negative correlation. Moreover, most participants cannot distinguish AI-generated art from human-made designs. This study provides insights into the potential use of generative art for mobile wallpapers.},
  description={Chinese CHI 2024.},
  keywords={Generative AI, Creative AI, Aesthetics, HCI}
}

@inproceedings{wang2026emotistage,
  selected={true},
  preview={emotistage-teaser.png},
  title = {EmotiStage: Designing an Emotion-Driven Performance System with Multi-modal Generative AI to Support Emotional Awareness},
  author = {Ziying Wang* and Yihong Lin* and Xianglin Zhao and Yirui Huang and Ziya Zhou and Wei Xue and Wanling Cai and Yucheng Jin},
  year = {2026},
  month = {10},
  booktitle = {Proceedings of the 28th ACM International Conference on Multimodal Interaction},
  doi = {10.1145/3776574.3831173},
  url = {https://dl.acm.org/doi/pdf/10.1145/3776574.3831173},
  pages = {624--633},
  abstract = {Emotional awareness is a foundational component of mental wellbeing, yet existing digital tools often reduce emotional experience to labels, metrics, or inferred states. Such approaches overlook how emotional awareness is constructed through embodied, multimodal experience and reflective sense-making. We present EmotiStage, an emotion-driven performance system powered by multimodal generative AI that supports emotional awareness by enabling users to externalize, observe, and reinterpret emotions through music and stage performance. By guiding users through a creator-to-spectator transition, EmotiStage introduces aesthetic and psychological distance, allowing users to re-encounter their internal states as a staged performance. A mixed-method study (N = 13) suggests that EmotiStage supports emotional awareness by facilitating a progression from expression to observation, helping users visualize and re-experience emotional experiences. We contribute EmotiStage, a multi-modal generative AI system for emotional awareness, alongside exploratory empirical findings and design implications for using multi-modal generative arts to support emotional awareness in mental well-being contexts.},
  description={Long paper, ICMI 2026 (Napoli, Italy). Co-first author with Yihong Lin.},
  keywords={Creative AI, Emotional Awareness, Multimodal Generative AI, Human-Computer Interaction}
}

@inproceedings{hong2026really,
  selected={true},
  preview={you-really-didnt-get-that-teaser.png},
  title = {You Really Didn’t Get That? Benchmarking Social Pragmatic Inference for Indirect and Playful Chinese Online Comments},
  author = {Shiwei Hong and Junjie Ma and Emma Jiren Wang and Ethan Z. Rong and Siying Hu and Haichang Li and Ziying Wang and Zhicong Lu},
  year = {2026},
  month = {10},
  booktitle = {Proceedings of the 2026 Conference on Empirical Methods in Natural Language Processing},
  doi = {10.18653/2026.emnlp-main.846},
  url = {https://aclanthology.org/2026.emnlp-main.846.pdf},
  pages = {19623--19640},
  abstract = {Chinese online comments often convey social meaning through indirect and playful language that is hard to interpret without context. Existing evaluations largely organize items around predefined phenomena or controlled pragmatic categories, leaving open whether models can distinguish plausible readings of what a naturally occurring comment is doing in a particular exchange. We introduce a benchmark for evaluating whether LLMs can recover such situated pragmatic meanings. From more than 200,000 public Chinese social media interaction records, we construct 4,735 human-validated diagnostic items, each pairing a target comment with reconstructed preceding context and plausible misreadings. We evaluate eight LLMs as both question writers and solvers in a cross-writer setting. The task is challenging: the strongest model achieves 81.42% leave-writer-out accuracy. Across all eight models, the mean leave-writer-out accuracy is 68.70% while human accuracy was 90.8%. Case analysis shows that models often recognize broad irony or playfulness while misidentifying the mechanism or interactional move.},
  description={EMNLP 2026 (Budapest, Hungary).},
  keywords={Social Pragmatics, Chinese Online Comments, Large Language Models, Benchmark}
}

@misc{lee2026guide,
  selected={true},
  preview={guide-teaser.png},
  title = {GUIDE: Designer-in-the-loop Authoring of Conformant Generative User Interfaces},
  author = {Hyewon Lee and Ziying Wang and Aiden Moy and Saran Nagubandi and Jason Wu},
  year = {2026},
  month = {9},
  journal = {arXiv preprint arXiv:2609.21285},
  doi = {10.48550/arXiv.2609.21285},
  url = {https://arxiv.org/pdf/2609.21285},
  abstract = {Generative User Interfaces (GenUIs) enable applications to generate interfaces on demand from user needs and context. Like conventional UIs, they must still reflect designers' intent and conform to requirements such as brand identity. Unlike conventional UIs, designers cannot directly specify or see every interface a GenUI may produce, making design intent harder to enforce. We introduce GUIDE (GenUI Development Environment), a system that lets designers continuously inspect and refine GenUI behavior as they create and edit interfaces. GUIDE uses designers' modifications and interactions to adapt GenUIs through prompt optimization and a novel adaptive conformance scoring model. We validate GUIDE's scoring model and system. The scoring model matched or outperformed proprietary LLM baselines on held-out comparisons of real and synthetic application screens. In a study with 12 UI/UX practitioners, participants found GUIDE effective and usable and significantly preferred aligned outputs over a strong baseline using exemplars and a model-generated design.md.},
  description={arXiv preprint.},
  keywords={Generative User Interfaces, Human-Computer Interaction, Interface Authoring, Design Tools}
}
